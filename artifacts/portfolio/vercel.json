{
  "framework": "vite",
  "buildCommand": "pnpm --filter @workspace/portfolio run build",
  "outputDirectory": "artifacts/portfolio/dist/public",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.rss2json.com https://api.microlink.io https://formspree.io; form-action 'self' https://formspree.io; frame-ancestors 'none';" }
      ]
    }
  ],
  "redirects": [
    { "source": "/projects", "destination": "/work", "permanent": true },
    { "source": "/media", "destination": "/news", "permanent": true },
    { "source": "/services", "destination": "/contact", "permanent": true },
    { "source": "/skills", "destination": "/ai-training", "permanent": true },
    { "source": "/work/:path+", "destination": "/work", "permanent": true },
    { "source": "/blog/:path+", "destination": "/blog", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/ai-training", "destination": "/ai-training/index.html" },
    { "source": "/ai-trainer-nepal", "destination": "/ai-trainer-nepal/index.html" },
    { "source": "/ai-trainer-nepal/", "destination": "/ai-trainer-nepal/index.html" },
    { "source": "/experience", "destination": "/experience/index.html" },
    { "source": "/work", "destination": "/work/index.html" },
    { "source": "/volunteering", "destination": "/volunteering/index.html" },
    { "source": "/certifications", "destination": "/certifications/index.html" },
    { "source": "/news", "destination": "/news/index.html" },
    { "source": "/recommendations", "destination": "/recommendations/index.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/open-source", "destination": "/open-source/index.html" },
    { "source": "/agentic-ai-skills-workshop", "destination": "/agentic-ai-skills-workshop/index.html" },
    { "source": "/ai-training-sme-operations", "destination": "/ai-training-sme-operations/index.html" },
    { "source": "/ai-training-hr-nepal", "destination": "/ai-training-hr-nepal/index.html" },
    { "source": "/ai-training-teachers-nepal", "destination": "/ai-training-teachers-nepal/index.html" }
  ]
}
